# Listening works without any of these. Accounts need the first three
# plus a rebuild after VITE_AUTH_ENABLED changes (it is inlined at build).

VITE_AUTH_ENABLED=true
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://atmanmusic.app
# Optional extra trusted origins (comma/space). Production already trusts
# atmanmusic.app, www.atmanmusic.app, and trismegistus-smlc-1397.vercel.app.
# BETTER_AUTH_TRUSTED_ORIGINS=

# Already set on Vercel Production/Preview.
# DATABASE_URL=

# Paid raw-master MP3s (£0.99 GBP). Test keys first. Never commit live secrets.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Optional Stripe Price ID. When unset, Checkout uses 99 pence GBP price_data.
# STRIPE_PRICE_ID=price_...
# MASTER_PRICE_PENCE=99
# VITE_MASTER_PRICE_PENCE=99
# DOWNLOAD_TOKEN_SECRET=
# Private Vercel Blob store for masters/<slug>.mp3 (not git).
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# Preview without Stripe: MASTER_DRY_RUN=1 serves the silent fixture.
# MASTER_DRY_RUN=1
# Extra slugs for sale without a catalog downloadKey (comma list or *).
# MASTER_SALE_SLUGS=

# Optional full-page Google / X via the Grok auth broker.
# Leave unset to keep email + password as the mobile account path.
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
