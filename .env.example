# Listening works without any of these. Accounts need the first three
# plus a rebuild after VITE_AUTH_ENABLED changes (it is inlined at build).

VITE_AUTH_ENABLED=true
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://atmanmusic.app
# Optional extra trusted origins (comma/space). Production already trusts
# atmanmusic.app, www.atmanmusic.app, and trismegistus-smlc-1397.vercel.app.
# BETTER_AUTH_TRUSTED_ORIGINS=

# Already set on Vercel Production/Preview.
# DATABASE_URL=

# Paid raw-master MP3 downloads (Stripe Checkout, GBP).
# Default price is £1.99 if TRACK_DOWNLOAD_PRICE_GBP is unset.
# TRACK_DOWNLOAD_PRICE_GBP=1.99
# VITE_TRACK_DOWNLOAD_PRICE_GBP=1.99
# Optional Stripe Price IDs instead of ad-hoc price_data:
# TRACK_DOWNLOAD_PRICE_ID=price_...
# TRACK_DOWNLOAD_PRICE_IDS={"the-sleepers-waking":"price_..."}
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# DOWNLOAD_TOKEN_SECRET=
# DOWNLOAD_TOKEN_TTL_HOURS=48
# DOWNLOAD_MAX_USES=6
# Preview/local without Stripe keys uses a dry-run success page + silent fixture.
# DOWNLOAD_DRY_RUN=true
# DOWNLOAD_ALLOW_FIXTURE=true

# Optional full-page Google / X via the Grok auth broker.
# Leave unset to keep email + password as the mobile account path.
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
